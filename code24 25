
#pragma once
#include <QObject>
#include <QString>

class BrandSettingsApi : public QObject {
    Q_OBJECT
public:
    explicit BrandSettingsApi(QObject* parent = nullptr);
    Q_INVOKABLE void open(const QString& brand);
};


#include "BrandSettingsApi.h"
#ifdef Q_OS_ANDROID
#include <QJniObject>
#include <QNativeInterface>
#endif

BrandSettingsApi::BrandSettingsApi(QObject* parent) : QObject(parent) {}

void BrandSettingsApi::open(const QString& brand) {
#ifdef Q_OS_ANDROID
    QJniObject context = QNativeInterface::QAndroidApplication::context();
    QJniObject jBrand = QJniObject::fromString(brand);
    QJniObject::callStaticMethod<void>(
        "org/qtproject/example/BrandSettingsHelper",
        "open",
        "(Landroid/content/Context;Ljava/lang/String;)V",
        context.object(), jBrand.object());
#else
    Q_UNUSED(brand);
#endif
}
