
#pragma once
#include <QObject>
#include <QTimer>

// 有 QtSensors 模块时启用真实加速度传感器，否则降级为空实现
#if __has_include(<QAccelerometer>)
#define CANSAI_HAS_SENSORS 1
#include <QAccelerometer>
#else
#define CANSAI_HAS_SENSORS 0
#endif

class FallDetector : public QObject {
    Q_OBJECT
    Q_PROPERTY(bool running READ running NOTIFY runningChanged)
public:
    explicit FallDetector(QObject* parent = nullptr);
    bool running() const { return m_running; }
    Q_INVOKABLE void start();
    Q_INVOKABLE void stop();

signals:
    void fallDetected(double magnitude);
    void runningChanged();

private:
#if CANSAI_HAS_SENSORS
    QAccelerometer m_accel;
#endif
    QTimer m_cooldownTimer;
    bool m_running = false;
    bool m_cooldown = false;
    int m_abnormalCount = 0;
    void onReading();
};

#include "FallDetector.h"
#include <cmath>

FallDetector::FallDetector(QObject* parent) : QObject(parent) {
#if CANSAI_HAS_SENSORS
    m_accel.setAlwaysOn(true);
    m_accel.setDataRate(50);
    connect(&m_accel, &QAccelerometer::readingChanged,
        this, &FallDetector::onReading);
#endif
    m_cooldownTimer.setSingleShot(true);
    m_cooldownTimer.setInterval(10000);
    connect(&m_cooldownTimer, &QTimer::timeout, this, [this]() {
        m_cooldown = false;
        });
}

void FallDetector::start() {
    if (m_running) return;
#if CANSAI_HAS_SENSORS
    m_accel.start();
#endif
    m_running = true;
    emit runningChanged();
}

void FallDetector::stop() {
    if (!m_running) return;
#if CANSAI_HAS_SENSORS
    m_accel.stop();
#endif
    m_running = false;
    emit runningChanged();
}

void FallDetector::onReading() {
#if CANSAI_HAS_SENSORS
    auto* r = m_accel.reading();
    double mag = std::sqrt(r->x() * r->x() + r->y() * r->y() + r->z() * r->z());

    if (mag > 3.0 * 9.8 && !m_cooldown) {
        if (++m_abnormalCount >= 10) {
            m_cooldown = true;
            m_abnormalCount = 0;
            emit fallDetected(mag);
            m_cooldownTimer.start();
        }
    }
    else {
        m_abnormalCount = 0;
    }
#endif
}


















